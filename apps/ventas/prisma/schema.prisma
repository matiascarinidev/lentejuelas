generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider     = "postgresql"
    url          = env("VENTAS_DATABASE_URL")
    relationMode = "prisma"
}

model Cliente {
    id        String   @id @default(cuid())
    nombre    String
    telefono  String?
    email     String?
    direccion String?
    activo    Boolean  @default(true)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    pedidos   Pedido[]
    ventasPOS VentaPOS[]
}

model Pedido {
    id           String       @id @default(cuid())
    clienteId    String
    cliente      Cliente      @relation(fields: [clienteId], references: [id])
    fecha        DateTime     @default(now())
    fechaEntrega DateTime?
    estado       EstadoPedido @default(PENDIENTE)
    tipo         TipoPedido   @default(STOCK)
    total        Decimal      @db.Decimal(10, 2)
    observacion  String?
    createdAt    DateTime     @default(now())
    updatedAt    DateTime     @updatedAt

    items PedidoItem[]
}

enum EstadoPedido {
    PENDIENTE
    EN_PRODUCCION
    LISTO
    ENTREGADO
    CANCELADO
}

enum TipoPedido {
    STOCK
    ENCARGO
}

model PedidoItem {
    id             String  @id @default(cuid())
    pedidoId       String
    pedido         Pedido  @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
    productoId     String
    cantidad       Int
    precioUnitario Decimal @db.Decimal(10, 2)
    subtotal       Decimal @db.Decimal(10, 2)
}

model Mesa {
    id     Int        @id @default(autoincrement())
    numero Int        @unique
    estado EstadoMesa @default(LIBRE)
    activo Boolean    @default(true)

    comandas Comanda[]
}

enum EstadoMesa {
    LIBRE
    OCUPADA
    RESERVADA
}

model Comanda {
    id            String        @id @default(cuid())
    mesaId        Int
    mesa          Mesa          @relation(fields: [mesaId], references: [id])
    fechaApertura DateTime      @default(now())
    fechaCierre   DateTime?
    estado        EstadoComanda @default(ABIERTA)
    total         Decimal       @default(0) @db.Decimal(10, 2)
    observacion   String?
    createdAt     DateTime      @default(now())
    updatedAt     DateTime      @updatedAt

    items ComandaItem[]
}

enum EstadoComanda {
    ABIERTA
    CERRADA
    CANCELADA
}

model ComandaItem {
    id               String            @id @default(cuid())
    comandaId        String
    comanda          Comanda           @relation(fields: [comandaId], references: [id], onDelete: Cascade)
    productoId       String
    cantidad         Int
    precioUnitario   Decimal           @db.Decimal(10, 2)
    subtotal         Decimal           @db.Decimal(10, 2)
    esProductoPropio Boolean           @default(true)
    estado           EstadoItemComanda @default(PENDIENTE)
}

enum EstadoItemComanda {
    PENDIENTE
    EN_PREPARACION
    LISTO
    ENTREGADO
    CANCELADO
}

model VentaPOS {
    id          String     @id @default(cuid())
    clienteId   String?
    cliente     Cliente?   @relation(fields: [clienteId], references: [id])
    fecha       DateTime   @default(now())
    total       Decimal    @db.Decimal(10, 2)
    metodoPago  MetodoPago @default(EFECTIVO)
    observacion String?
    createdAt   DateTime   @default(now())

    items VentaPOSItem[]
}

enum MetodoPago {
    EFECTIVO
    TARJETA
    TRANSFERENCIA
    OTRO
}

model VentaPOSItem {
    id               String   @id @default(cuid())
    ventaPOSId       String
    ventaPOS         VentaPOS @relation(fields: [ventaPOSId], references: [id], onDelete: Cascade)
    productoId       String
    cantidad         Int
    precioUnitario   Decimal  @db.Decimal(10, 2)
    subtotal         Decimal  @db.Decimal(10, 2)
    esProductoPropio Boolean  @default(true)
}

//AUDITORIA
model AuditLog {
    id        String   @id @default(cuid())
    usuario   String   @default("sistema")
    accion    String
    entidad   String
    entidadId String
    antes     Json?
    despues   Json?
    createdAt DateTime @default(now())
}
