generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("CORE_DATABASE_URL")
}

// ─── CATEGORÍAS Y ENUM ──────────────────────────

enum TipoInsumo {
  MATERIA_PRIMA
  ENVASE
  ETIQUETA
  OPERATIVO // gas, electricidad prorrateable, etc.
}

enum UnidadMedida {
  GRAMOS
  KILOGRAMOS
  MILILITROS
  LITROS
  UNIDAD
  PAQUETE
  BOLSA
  CAJA
  MAPLE
  MANOJO
  CABEZA
  ROLLO
}

enum TipoMovimientoStock {
  ENTRADA
  SALIDA
}

// ─── PRODUCTOS ──────────────────────────────────
model CategoriaProducto {
  id        String   @id @default(cuid())
  nombre    String   @unique
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  productos Producto[]
}

model Categoria {
  id        String     @id @default(cuid())
  nombre    String     @unique
  activo    Boolean    @default(true)
  productos Producto[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Producto {
  id                  String     @id @default(cuid())
  nombre              String
  categoriaId         String?
  categoria           Categoria? @relation(fields: [categoriaId], references: [id])
  esProduccionPropia  Boolean    @default(true)
  costoCompra         Decimal?   @db.Decimal(10, 2)
  margenGanancia      Decimal?   @default(30) @db.Decimal(5, 2)
  precioVentaSugerido Decimal    @db.Decimal(10, 2)
  precioVentaFinal    Decimal?   @db.Decimal(10, 2)
  stockActual         Int        @default(0)
  activo              Boolean    @default(true)
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  recetas               Receta[]
  lotesProduccion       ProduccionLote[]
  movimientosStock      MovimientoStock[]
  categoriaProducto     CategoriaProducto?     @relation(fields: [categoriaProductoId], references: [id])
  categoriaProductoId   String?
  productoPOSVentaItems ProductoPOSVentaItem[]
  productoComandaItems  ProductoComandaItem[]
  pedidoItem            PedidoItem?            @relation(fields: [pedidoItemId], references: [id])
  pedidoItemId          String?
}

model POSVentaItem {
  id        String                 @id @default(cuid())
  productos ProductoPOSVentaItem[]
}

model ProductoPOSVentaItem {
  id             String       @id @default(cuid())
  productoId     String
  producto       Producto     @relation(fields: [productoId], references: [id])
  posVentaItemId String
  posVentaItem   POSVentaItem @relation(fields: [posVentaItemId], references: [id])
}

model ComandaItem {
  id        String                @id @default(cuid())
  productos ProductoComandaItem[]
}

model ProductoComandaItem {
  id            String      @id @default(cuid())
  productoId    String
  producto      Producto    @relation(fields: [productoId], references: [id])
  comandaItemId String
  comandaItem   ComandaItem @relation(fields: [comandaItemId], references: [id])
}

model PedidoItem {
  id        String     @id @default(cuid())
  productos Producto[]
}

// ─── RECETAS (con herencia base/variante) ──────

model Receta {
  id                  String    @id @default(cuid())
  productoId          String
  producto            Producto  @relation(fields: [productoId], references: [id], onDelete: Cascade)
  varianteNombre      String?
  recetaBaseId        String?
  recetaBase          Receta?   @relation("RecetaBase", fields: [recetaBaseId], references: [id])
  variantes           Receta[]  @relation("RecetaBase")
  rendimientoBase     Int       @default(1)
  unidadesPorPack     Int? // null = venta por unidad; 4 = pack de 4
  activa              Boolean   @default(true)
  fechaVigenciaInicio DateTime  @default(now())
  fechaVigenciaFin    DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  items           RecetaItem[]
  itemsPackaging  RecetaItemPackaging[]
  lotesUtilizados ProduccionLote[]
}

model RecetaItemPackaging {
  id       String       @id @default(cuid())
  recetaId String
  receta   Receta       @relation(fields: [recetaId], references: [id], onDelete: Cascade)
  insumoId String
  insumo   Insumo       @relation(fields: [insumoId], references: [id])
  cantidad Decimal      @db.Decimal(10, 3)
  unidad   UnidadMedida
}

model RecetaItem {
  id              String       @id @default(cuid())
  recetaId        String
  receta          Receta       @relation(fields: [recetaId], references: [id], onDelete: Cascade)
  insumoId        String
  insumo          Insumo       @relation(fields: [insumoId], references: [id])
  cantidad        Decimal      @db.Decimal(10, 3)
  unidad          UnidadMedida
  mermaPorcentaje Decimal      @default(0) @db.Decimal(5, 2) // base: 0, pero queda listo si en futuro lo usás
}

// ─── INSUMOS ────────────────────────────────────

model Insumo {
  id                    String       @id @default(cuid())
  nombre                String
  tipo                  TipoInsumo
  unidadBase            UnidadMedida
  unidadCompra          UnidadMedida
  factorConversion      Decimal      @db.Decimal(10, 4) // 1 BOLSA = 25000 GRAMOS -> factor = 25000
  costoUnitarioEstimado Decimal      @db.Decimal(10, 4) // costo por unidad base, actualizado con últimas compras
  stockActual           Decimal      @default(0) @db.Decimal(10, 3)
  stockMinimo           Decimal      @default(0) @db.Decimal(10, 3) // para alertas
  activo                Boolean      @default(true)
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  proveedorId String?
  proveedor   Proveedor? @relation(fields: [proveedorId], references: [id])

  recetaItems          RecetaItem[]
  compraItems          CompraInsumoItem[]
  movimientosStock     MovimientoStock[]
  recetaItemPackagings RecetaItemPackaging[]
}

// ─── PROVEEDORES ────────────────────────────────

model Proveedor {
  id        String   @id @default(cuid())
  nombre    String
  contacto  String?
  telefono  String?
  email     String?
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())

  insumos Insumo[]
  compras CompraInsumo[]
}

// ─── COMPRAS ────────────────────────────────────

model CompraInsumo {
  id          String     @id @default(cuid())
  proveedorId String?
  proveedor   Proveedor? @relation(fields: [proveedorId], references: [id])
  fecha       DateTime   @default(now())
  total       Decimal    @db.Decimal(10, 2)
  observacion String?
  createdAt   DateTime   @default(now())

  items       CompraInsumoItem[]
  movimientos MovimientoStock[]
}

model CompraInsumoItem {
  id             String       @id @default(cuid())
  compraId       String
  compra         CompraInsumo @relation(fields: [compraId], references: [id], onDelete: Cascade)
  insumoId       String
  insumo         Insumo       @relation(fields: [insumoId], references: [id])
  cantidadCompra Decimal      @db.Decimal(10, 3) // en unidad de compra (ej: 2 bolsas)
  precioUnitario Decimal      @db.Decimal(10, 4) // precio por unidad de compra
  subtotal       Decimal      @db.Decimal(10, 2)
}

// ─── PRODUCCIÓN ─────────────────────────────────

model ProduccionLote {
  id                  String            @id @default(cuid())
  productoId          String
  producto            Producto          @relation(fields: [productoId], references: [id])
  recetaId            String
  receta              Receta            @relation(fields: [recetaId], references: [id])
  fechaProduccion     DateTime          @default(now())
  fechaVencimiento    DateTime?
  cantidadPlanificada Int
  cantidadReal        Int
  horasProduccion     Decimal?          @db.Decimal(4, 1)
  costoTotalCalculado Decimal           @db.Decimal(10, 2)
  costoUnitarioFinal  Decimal           @db.Decimal(10, 4)
  costoMateriaPrima   Decimal           @default(0) @db.Decimal(10, 2)
  costoPackaging      Decimal           @default(0) @db.Decimal(10, 2)
  costoOperativo      Decimal           @default(0) @db.Decimal(10, 2)
  costoAmortizacion   Decimal           @default(0) @db.Decimal(10, 2)
  observacion         String?
  createdAt           DateTime          @default(now())
  mermaReal           Int               @default(0)
  motivoMerma         String?
  movimientos         MovimientoStock[]
}

// ─── STOCK (movimientos unificados) ─────────────

model MovimientoStock {
  id    String              @id @default(cuid())
  tipo  TipoMovimientoStock
  fecha DateTime            @default(now())

  // uno de estos según si es insumo o producto terminado
  insumoId   String?
  insumo     Insumo?   @relation(fields: [insumoId], references: [id])
  productoId String?
  producto   Producto? @relation(fields: [productoId], references: [id])

  cantidad Decimal      @db.Decimal(10, 3)
  unidad   UnidadMedida

  // origen del movimiento
  compraId String?
  compra   CompraInsumo?   @relation(fields: [compraId], references: [id])
  loteId   String?
  lote     ProduccionLote? @relation(fields: [loteId], references: [id])

  observacion String?
}

// ─── GASTOS OPERATIVOS Y AMORTIZACIONES ─────────

model GastoOperativo {
  id           String   @id @default(cuid())
  concepto     String
  monto        Decimal  @db.Decimal(10, 2)
  fecha        DateTime @default(now())
  prorrateable Boolean  @default(false)
  esManoDeObra Boolean  @default(false)
  costoPorHora Decimal? @db.Decimal(10, 2)
  createdAt    DateTime @default(now())
}

model ActivoAmortizable {
  id               String   @id @default(cuid())
  descripcion      String
  valorAdquisicion Decimal  @db.Decimal(10, 2)
  vidaUtilTandas   Int      @default(1000)
  tandasAcumuladas Int      @default(0)
  costoPorTanda    Decimal  @default(0) @db.Decimal(10, 4)
  activo           Boolean  @default(true)
  fechaInicio      DateTime @default(now())
  createdAt        DateTime @default(now())
}
